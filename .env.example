# Postgres — Railway sets this automatically when you add the Postgres plugin
# to this project. You don't set it by hand; just make sure the plugin is
# attached and linked to this service.
DATABASE_URL=postgresql://user:pass@host:5432/railway

# Wikipedia asks for a descriptive contact string, not a real credential
WIKI_CONTACT=your-name (you@example.com)

# TMDb — Settings > API > "API Read Access Token" (the long one, NOT the short API Key)
TMDB_READ_TOKEN=your_tmdb_v4_read_access_token

# Kalshi — from your account's API Keys page. KALSHI_PRIVATE_KEY is the FULL
# PEM file contents (not a file path — paste the whole thing, including the
# -----BEGIN/END PRIVATE KEY----- lines), since Railway's filesystem doesn't
# persist between deploys. Only needed for authenticated endpoints — the
# market/ladder data itself is public and works without these.
KALSHI_KEY_ID=your_kalshi_key_id
KALSHI_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----
KALSHI_SERIES_TICKER=KXNETFLIXRANKSHOW

# Google Sheets — service account JSON as a single-line string (paste the
# entire file contents), plus the target spreadsheet's ID from its URL.
# Share the sheet with the service account's email as an Editor.
GOOGLE_SHEETS_ID=your_google_sheet_id
GOOGLE_SERVICE_ACCOUNT_JSON={"type": "service_account", "project_id": "...", ...}
